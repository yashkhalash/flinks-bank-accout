# Flinks instance details (from your Flinks dashboard URL / account settings)
# Dashboard: https://dashboard.flinks.com/en/9a67f484-5300-4d20-a1fa-ea9a4e374318/home

# Your Flinks Customer/Instance ID (the GUID in the dashboard URL above)
FLINKS_CUSTOMER_ID=9a67f484-5300-4d20-a1fa-ea9a4e374318

# The Connect (iframe) URL is https://dashboard.flinks.com/en/<FLINKS_CUSTOMER_ID>/connect/embedded
# — this matches the "Embedded" preview shown in Dashboard > Connect > Embedded.

# The subdomain assigned to your instance for Flinks API calls (GetAccountsDetail, etc).
# Found under Dashboard > Connect > Embedded > Generate code (shows the exact API base URL),
# or Dashboard > Settings > API.
FLINKS_SUBDOMAIN=your-subdomain

# Environment: sandbox (Toolbox, fake banks) or production
FLINKS_ENV=sandbox

# Flinks Connect iframe — must match your API instance.
# Working sandbox: https://toolbox-iframe.private.fin.ag/v2/  (with FLINKS_DEMO=true)
# Do NOT point this at demo.flinks.com while using Toolbox API keys — the widget breaks.
FLINKS_IFRAME_BASE_URL=https://toolbox-iframe.private.fin.ag/v2/

# true = FlinksCapital in Toolbox. Required for sandbox API testing.
FLINKS_DEMO=true

# Environment: sandbox or production
FLINKS_ENV=sandbox

# Base API URL — Toolbox sandbox:
FLINKS_API_BASE_URL=https://toolbox-api.private.fin.ag/v3

# Server port
PORT=3000

# Local app URL — must match where you're running this and be whitelisted
# in the Flinks dashboard (Configuration > Allowed domains) for the Connect
# iframe / postMessage flow to work.
APP_URL=http://localhost:3000
